<!doctype html>
<!--
  ★ lang 은 반드시 "ko" — Vite 템플릿 기본값 "en" 으로 되돌리지 말 것 (2026-08-10).
    모바일 크롬이 이 사이트를 영어로 보고 **번역 배너를 띄우던** 원인이었다.
    크롬은 ① Content-Language 헤더 ② <html lang> ③ 본문 자동감지 순으로 페이지 언어를 정하는데,
    우리는 헤더가 없고 SPA 라 파싱 시점의 <body> 가 비어 있다(React 가 아직 안 그렸다).
    그래서 판단 재료가 lang="en" 과 영어 단어인 <title>ROOT</title> 뿐이라 영어로 확정됐다.
    (public/404.html 은 처음부터 lang="ko" 였다 — 진입 문서만 기본값이 남아 있었다.)
-->
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/sbt_img_logo_only.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 아이콘 폰트 — **자체 호스팅**(2026-09-24). 종전엔 fonts.googleapis.com 을 불렀는데
         광고·추적 차단 확장이 막으면 아이콘이 전부 영어 단어로 보였다. 이유·갱신법은
         public/fonts/material-symbols/material-symbols.css 머리말 참조. -->
    <link rel="preload" as="font" type="font/woff2"
          href="/fonts/material-symbols/MaterialSymbolsRounded.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/material-symbols/material-symbols.css" />
    <title>ROOT</title>
    <!-- 한국어 본문이 하나라도 있어야 크롬 자동감지가 lang="ko" 를 뒷받침한다(위 주석). -->
    <meta name="description" content="FC 영업·고객관리 세일즈 시스템" />
    <!-- GitHub Pages SPA: decode redirect from 404.html -->
    <script>
      (function(l) {
        if (l.search[1] === '/') {
          var decoded = l.search.slice(1).split('&').map(function(s) {
            return s.replace(/~and~/g, '&');
          }).join('?');
          window.history.replaceState(null, null,
            l.pathname.slice(0, -1) + decoded + l.hash
          );
        }
      }(window.location));
    </script>
    <script type="module" crossorigin src="/assets/index-Dx5ESyVi.js"></script>
    <link rel="modulepreload" crossorigin href="/assets/rolldown-runtime-Dd_uD5pT.js">
    <link rel="modulepreload" crossorigin href="/assets/react-HW-SxgkS.js">
    <link rel="modulepreload" crossorigin href="/assets/constants-LEqQdjsf.js">
    <link rel="modulepreload" crossorigin href="/assets/react-pdf.browser-Dx8jgD3v.js">
    <link rel="stylesheet" crossorigin href="/assets/index-BlhNBn25.css">
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
